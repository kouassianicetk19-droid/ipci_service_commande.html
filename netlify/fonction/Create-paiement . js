exports.handler = async (event) => {
  const headers = {
    "Content-Type": "application/json"
  };

  // Autoriser uniquement POST
  if (event.httpMethod !== "POST") {
    return {
      statusCode: 405,
      headers,
      body: JSON.stringify({
        success: false,
        error: "Méthode non autorisée"
      })
    };
  }

  try {
    // Vérifier les clés PayDunya
    const masterKey = process.env.paydunya;
    const publicKey = process.env.Publique;
    const privateKey = process.env.PRIVATE;
    const token = process.env.Token;

    if (!masterKey || !publicKey || !privateKey || !token) {
      return {
        statusCode: 500,
        headers,
        body: JSON.stringify({
          success: false,
          error: "Les clés PayDunya ne sont pas configurées correctement dans Netlify."
        })
      };
    }

    // Récupérer les données envoyées par le formulaire
    let body;

    try {
      body = JSON.parse(event.body || "{}");
    } catch (error) {
      return {
        statusCode: 400,
        headers,
        body: JSON.stringify({
          success: false,
          error: "Le serveur a reçu des données JSON invalides."
        })
      };
    }

    const nom = body.nom;
    const telephone = body.telephone;
    const offre = body.offre;
    const prix = body.prix;
    const paiement = body.paiement;
    const message = body.message || "";

    // Vérification
    if (!nom || !telephone || !offre || !prix || !paiement) {
      return {
        statusCode: 400,
        headers,
        body: JSON.stringify({
          success: false,
          error: "Veuillez remplir tous les champs obligatoires."
        })
      };
    }

    const montant = Number(prix);

    if (!Number.isFinite(montant) || montant <= 0) {
      return {
        statusCode: 400,
        headers,
        body: JSON.stringify({
          success: false,
          error: "Le prix indiqué est incorrect."
        })
      };
    }

    // Appel PayDunya
    const paydunyaResponse = await fetch(
      "https://app.paydunya.com/api/v1/checkout-invoice/create",
      {
        method: "POST",

        headers: {
          "Content-Type": "application/json",
          "PAYDUNYA-MASTER-KEY": masterKey,
          "PAYDUNYA-PUBLIC-KEY": publicKey,
          "PAYDUNYA-PRIVATE-KEY": privateKey,
          "PAYDUNYA-TOKEN": token
        },

        body: JSON.stringify({
          invoice: {
            total_amount: montant,
            description: `Commande IPCI SERVICE - ${offre} - ${nom} - ${telephone}`
          },

          store: {
            name: "IPCI SERVICE"
          },

          custom_data: {
            nom: nom,
            telephone: telephone,
            offre: offre,
            paiement: paiement,
            message: message
          }
        })
      }
    );

    // Lire la réponse
    const texte = await paydunyaResponse.text();

    console.log("Réponse PayDunya :", texte);

    if (!texte) {
      return {
        statusCode: 502,
        headers,
        body: JSON.stringify({
          success: false,
          error: "PayDunya a renvoyé une réponse vide.",
          status: paydunyaResponse.status
        })
      };
    }

    // Convertir en JSON
    let data;

    try {
      data = JSON.parse(texte);
    } catch (error) {
      return {
        statusCode: 502,
        headers,
        body: JSON.stringify({
          success: false,
          error: "PayDunya n'a pas renvoyé du JSON.",
          status: paydunyaResponse.status,
          reponse: texte.substring(0, 500)
        })
      };
    }

    console.log("Données PayDunya :", JSON.stringify(data));

    // Vérifier la réponse PayDunya
    if (data.response_code !== "00") {
      return {
        statusCode: 400,
        headers,
        body: JSON.stringify({
          success: false,
          error:
            data.response_text ||
            "PayDunya a refusé la création du paiement.",
          response_code: data.response_code
        })
      };
    }

    // Récupérer le lien de paiement
    const paymentUrl = data.response_text;

    if (!paymentUrl) {
      return {
        statusCode: 502,
        headers,
        body: JSON.stringify({
          success: false,
          error: "PayDunya n'a pas fourni de lien de paiement.",
          details: data
        })
      };
    }

    // Réponse finale
    return {
      statusCode: 200,
      headers,
      body: JSON.stringify({
        success: true,
        url: paymentUrl,
        token: data.token || null
      })
    };

  } catch (error) {
    console.error("Erreur :", error);

    return {
      statusCode: 500,
      headers,
      body: JSON.stringify({
        success: false,
        error: "Erreur serveur.",
        details: error.message
      })
    };
  }
};
