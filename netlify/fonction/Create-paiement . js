exports.handler = async (event) => {
  const headers = {
    "Content-Type": "application/json"
  };

  // Autoriser uniquement POST
  if (event.httpMethod !== "POST") {
    return {
      statusCode: 405,
      headers,
      body: JSON.stringify({
        success: false,
        error: "Méthode non autorisée"
      })
    };
  }

  try {
    // Vérification des clés PayDunya
    if (
      !process.env.paydunya ||
      !process.env.Publique ||
      !process.env.PRIVATE ||
      !process.env.Token
    ) {
      return {
        statusCode: 500,
        headers,
        body: JSON.stringify({
          success: false,
          error: "Les clés PayDunya ne sont pas correctement configurées dans Netlify."
        })
      };
    }

    // Lecture de la commande
    let body;

    try {
      body = JSON.parse(event.body || "{}");
    } catch (e) {
      return {
        statusCode: 400,
        headers,
        body: JSON.stringify({
          success: false,
          error: "Les données reçues ne sont pas un JSON valide."
        })
      };
    }

    const {
      nom,
      telephone,
      offre,
      prix,
      paiement,
      message
    } = body;

    // Vérification des informations
    if (!nom || !telephone || !offre || !prix || !paiement) {
      return {
        statusCode: 400,
        headers,
        body: JSON.stringify({
          success: false,
          error: "Informations de commande manquantes."
        })
      };
    }

    const montant = Number(prix);

    if (!Number.isFinite(montant) || montant <= 0) {
      return {
        statusCode: 400,
        headers,
        body: JSON.stringify({
          success: false,
          error: "Montant incorrect."
        })
      };
    }

    // Création de la facture PayDunya
    const response = await fetch(
      "https://app.paydunya.com/api/v1/checkout-invoice/create",
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "PAYDUNYA-MASTER-KEY": process.env.paydunya,
          "PAYDUNYA-PUBLIC-KEY": process.env.Publique,
          "PAYDUNYA-PRIVATE-KEY": process.env.PRIVATE,
          "PAYDUNYA-TOKEN": process.env.Token
        },
        body: JSON.stringify({
          invoice: {
            total_amount: montant,
            description:
              "Commande " +
              offre +
              " - Client : " +
              nom +
              " - Téléphone : " +
              telephone,

            customer: {
              name: nom,
              phone: telephone
            }
          },

          store: {
            name: "IPCI SERVICE"
          },

          custom_data: {
            telephone: telephone,
            offre: offre,
            mode_paiement: paiement,
            message: message || ""
          }
        })
      }
    );

    // Lire la réponse PayDunya comme texte
    const texte = await response.text();

    if (!texte) {
      return {
        statusCode: 502,
        headers,
        body: JSON.stringify({
          success: false,
          error: "PayDunya a renvoyé une réponse vide.",
          status_paydunya: response.status
        })
      };
    }

    // Conversion en JSON
    let data;

    try {
      data = JSON.parse(texte);
    } catch (e) {
      return {
        statusCode: 502,
        headers,
        body: JSON.stringify({
          success: false,
          error: "PayDunya a renvoyé une réponse qui n'est pas du JSON.",
          status_paydunya: response.status,
          reponse_paydunya: texte.substring(0, 1000)
        })
      };
    }

    // PayDunya a refusé la création
    if (data.response_code !== "00") {
      return {
        statusCode: 400,
        headers,
        body: JSON.stringify({
          success: false,
          error:
            data.response_text ||
            "PayDunya a refusé la création du paiement.",
          response_code: data.response_code,
          details: data
        })
      };
    }

    // Vérification de l'URL
    if (!data.response_text || !data.token) {
      return {
        statusCode: 502,
        headers,
        body: JSON.stringify({
          success: false,
          error:
            "PayDunya a créé la facture mais n'a pas fourni le lien de paiement.",
          details: data
        })
      };
    }

    // Succès
    return {
      statusCode: 200,
      headers,
      body: JSON.stringify({
        success: true,
        url: data.response_text,
        token: data.token
      })
    };

  } catch (error) {
    return {
      statusCode: 500,
      headers,
      body: JSON.stringify({
        success: false,
        error: "Erreur serveur.",
        details: error.message
      })
    };
  }
};
