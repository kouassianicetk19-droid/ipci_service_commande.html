exports.handler = async (event) => {
if (event.httpMethod !== "POST") {
return {
statusCode: 405,
headers: {
"Content-Type": "application/json"
},
body: JSON.stringify({
error: "Méthode non autorisée"
})
};
}

try {
const body = JSON.parse(event.body || "{}");

const {
  nom,
  telephone,
  offre,
  prix,
  paiement,
  message
} = body;

if (!nom || !telephone || !offre || !prix || !paiement) {
  return {
    statusCode: 400,
    headers: {
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      error: "Informations de commande manquantes"
    })
  };
}

const response = await fetch(
  "https://app.paydunya.com/api/v1/checkout-invoice/create",
  {
    method: "POST",

    headers: {
      "Content-Type": "application/json",
      "PAYDUNYA-MASTER-KEY": process.env.paydunya,
      "PAYDUNYA-PUBLIC-KEY": process.env.publique,
      "PAYDUNYA-PRIVATE-KEY": process.env.private,
      "PAYDUNYA-TOKEN": process.env.token
    },

    body: JSON.stringify({
      invoice: {
        total_amount: Number(prix),
        description:
          "Commande " +
          offre +
          " - Client : " +
          nom +
          " - Téléphone : " +
          telephone +
          " - Paiement : " +
          paiement,

        customer: {
          name: nom,
          phone: telephone
        }
      },

      store: {
        name: "IPCI SERVICE"
      }
    })
  }
);

// On lit d'abord la réponse comme texte
const responseText = await response.text();

// On essaie ensuite de convertir le texte en JSON
let data;

try {
  data = JSON.parse(responseText);
} catch (jsonError) {
  return {
    statusCode: 502,
    headers: {
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      error: "Réponse non JSON reçue de PayDunya",
      status: response.status,
      response: responseText
    })
  };
}

// Vérification de la réponse PayDunya
if (data.response_code !== "00") {
  return {
    statusCode: 400,
    headers: {
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      error: "PayDunya a refusé le paiement",
      response_code: data.response_code,
      response_text: data.response_text,
      details: data
    })
  };
}

// PayDunya fournit l'URL de paiement dans response_text
return {
  statusCode: 200,
  headers: {
    "Content-Type": "application/json"
  },
  body: JSON.stringify({
    success: true,
    url: data.response_text,
    token: data.token,
    data: data
  })
};

} catch (error) {

return {
  statusCode: 500,
  headers: {
    "Content-Type": "application/json"
  },
  body: JSON.stringify({
    error: "Erreur serveur",
    details: error.message
  })
};

}
};
